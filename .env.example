# Copie para .env e preencha. Nunca commite o .env.

# Banco (local: docker compose up -d)
DATABASE_URL=postgres://financas:financas@localhost:5432/financas

# Servidor
PORT=3000
NODE_ENV=development

# Login (usuário único)
APP_USER_EMAIL=voce@example.com
# Gere com: npm run hash-password
APP_PASSWORD_HASH=
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
